
FROM pytorch/pytorch:2.2.0-cuda12.1-cudnn8-runtime

WORKDIR /workspace

# 시스템 패키지
RUN apt-get update && apt-get install -y libgl1 libglib2.0-0 libsm6 libxext6 git && rm -rf /var/lib/apt/lists/*

COPY requirements-training.txt .
RUN pip install --no-cache-dir -r requirements-training.txt

COPY . .

# 학습 실행 (예: docker build -f Dockerfile.training -t smartmove-train . && docker run --gpus all smartmove-train)
CMD ["python", "train.py", "--epochs", "100", "--model", "yolov8m.pt"]
